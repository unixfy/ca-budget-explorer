{
	"name": "ca-budget-explorer",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"etl:rev": "node scripts/etl/revenues.ts",
		"etl:patch": "node scripts/etl/patch-meta.ts",
		"etl:exp": "node scripts/etl/expenditures.ts",
		"etl:recon": "node scripts/etl/reconciliation.ts",
		"etl:type": "node scripts/etl/bytype.ts",
		"etl:sources": "node scripts/etl/sources-catalog.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/barlow": "^5.3.0",
		"@fontsource/barlow-semi-condensed": "^5.3.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/d3": "^7.4.3",
		"@types/node": "^26",
		"@types/three": "^0.187.0",
		"daisyui": "^5.7.50",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"pdfjs-dist": "^6.5.438",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"xlsx": "^0.18.5"
	},
	"dependencies": {
		"d3": "^7.9.2",
		"motion": "^14.9.1",
		"three": "^0.187.0"
	}
}
