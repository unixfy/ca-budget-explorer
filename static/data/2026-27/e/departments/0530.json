54},"byFundType":{"special":{"py":0,"cy":154,"by":154}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":0,"cy":154,"by":154}}}},{"id":"exp/4000/0530/0280/f3414","kind":"fund","name":"988 State Suicide and Behavioral Health Crisis Services Fund","code":"3414","amounts":{"py":0,"cy":575,"by":445},"byFundType":{"special":{"py":0,"cy":575,"by":445}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":0,"cy":575,"by":445}}}}],"excludedChildren":[{"id":"exp/4000/0530/0280/f0995","kind":"fund","name":"Reimbursements","code":"0995","amounts":{"py":8588,"cy":6578,"by":2613},"byFundType":{"reimbursement":{"py":8588,"cy":6578,"by":2613}},"extra":{"fundType":"reimbursement","byAppropriationType":{"State Operations":{"py":8588,"cy":6578,"by":2613}}}},{"id":"exp/4000/0530/0280/f9740","kind":"fund","name":"Central Service Cost Recovery Fund","code":"9740","amounts":{"py":11154,"cy":11416,"by":11413},"byFundType":{"nongovernmental":{"py":11154,"cy":11416,"by":11413}},"extra":{"fundType":"nongovernmental","byAppropriationType":{"State Operations":{"py":11154,"cy":11416,"by":11413}}}}],"excluded":{"reimbursement":{"py":8588,"cy":6578,"by":2613},"nongovernmental":{"py":11154,"cy":11416,"by":11413}}},{"id":"exp/4000/0530/0285","kind":"program","name":"California Office of Health Information Integrity (CALOHII)","code":"0285","amounts":{"py":831,"cy":619,"by":619},"byFundType":{"general":{"py":831,"cy":619,"by":619}},"positions":{"py":4.2,"cy":4.2,"by":4.2},"description":"0285 - THE CALIFORNIA OFFICE OF HEALTH INFORMATION INTEGRITY\n\nThe California Office of Health Information Integrity (CalOHII) is responsible for statewide leadership, coordination, policy formation, direction, and oversight responsibilities for federal Health Insurance Portability and Accountability Act (HIPAA) requirements. As the leading resource for providing HIPAA expertise to the State of California, CalOHII exercises full authority relative to state entities to establish policy, provide direction to state entities, monitor progress and report on implementation efforts based on state and federal laws.","extra":{"byAppropriationType":{"State Operations":{"py":2219,"cy":2528,"by":1599}},"apiProgramLine":true},"children":[{"id":"exp/4000/0530/0285/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":831,"cy":619,"by":619},"byFundType":{"general":{"py":831,"cy":619,"by":619}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":831,"cy":619,"by":619}}}}],"excludedChildren":[{"id":"exp/4000/0530/0285/f0995","kind":"fund","name":"Reimbursements","code":"0995","amounts":{"py":1388,"cy":1909,"by":980},"byFundType":{"reimbursement":{"py":1388,"cy":1909,"by":980}},"extra":{"fundType":"reimbursement","byAppropriationType":{"State Operations":{"py":1388,"cy":1909,"by":980}}}}],"excluded":{"reimbursement":{"py":1388,"cy":1909,"by":980}}},{"id":"exp/4000/0530/0286","kind":"program","name":"Office of Youth and Community Restoration","code":"0286","amounts":{"py":242877,"cy":244833,"by":251350},"byFundType":{"general":{"py":229859,"cy":231815,"by":238332},"federal":{"py":13018,"cy":13018,"by":13018}},"positions":{"py":37,"cy":37,"by":39},"description":"0286 - OFFICE OF YOUTH AND COMMUNITY RESTORATION\n\nThe mission for the Office of Youth and Community Restoration is to support the transition of justice involved youth to be served in local communities and promote trauma responsive, culturally informed services for youth involved in the juvenile justice system that support the youths' successful transition into adulthood and help them become responsible, thriving, and engaged members of their communities.","extra":{"byAppropriationType":{"State Operations":{"py":38984,"cy":29268,"by":19741},"Local Assistance":{"py":223893,"cy":225565,"by":231609}},"apiProgramLine":true},"children":[{"id":"exp/4000/0530/0286/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":229859,"cy":231815,"by":238332},"byFundType":{"general":{"py":229859,"cy":231815,"by":238332}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":18194,"cy":18478,"by":18951},"Local Assistance":{"py":211665,"cy":213337,"by":219381}}}},{"id":"exp/4000/0530/0286/f0890","kind":"fund","name":"Federal Trust Fund","code":"0890","amounts":{"py":13018,"cy":13018,"by":13018},"byFundType":{"federal":{"py":13018,"cy":13018,"by":13018}},"extra":{"fundType":"federal","byAppropriationType":{"State Operations":{"py":790,"cy":790,"by":790},"Local Assistance":{"py":12228,"cy":12228,"by":12228}}}}],"excludedChildren":[{"id":"exp/4000/0530/0286/f0995","kind":"fund","name":"Reimbursements","code":"0995","amounts":{"py":20000,"cy":10000,"by":0},"byFundType":{"reimbursement":{"py":20000,"cy":10000,"by":0}},"extra":{"fundType":"reimbursement","byAppropriationType":{"State Operations":{"py":20000,"cy":10000,"by":0}}}}],"excluded":{"reimbursement":{"py":20000,"cy":10000,"by":0}}},{"id":"exp/4000/0530/0287","kind":"program","name":"California Initiative to Advance Precision Medicine","code":"0287","amounts":{"py":18971,"cy":12547,"by":0},"byFundType":{"general":{"py":18971,"cy":12547,"by":0}},"positions":{"py":0,"cy":0,"by":0},"description":"0287 - THE CALIFORNIA INITIATIVE TO ADVANCE PRECISION MEDICINE\n\nThe mission of the California Initiative to Advance Precision Medicine (CIAPM) is to support collaborative research and foster partnerships between the state, researchers, patients, communities, and industry to further the aims of this new approach to health and medicine. The initiative supports patient-focused research demonstration projects and connects health and medicine stakeholders from across California. CIAPM stimulates cross-sector collaborations among the State's scientists, clinicians, entrepreneurs, and patient participants, enabling them to translate available large data sets and technical innovation into better health outcomes.","extra":{"byAppropriationType":{"State Operations":{"py":18971,"cy":12547,"by":0}},"apiProgramLine":true},"children":[{"id":"exp/4000/0530/0287/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":18971,"cy":12547,"by":0},"byFundType":{"general":{"py":18971,"cy":12547,"by":0}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":18971,"cy":12547,"by":0}}}}]},{"id":"exp/4000/0530/0290","kind":"program","name":"Office of Technology and Solutions Integration","code":"0290","amounts":{"py":1864,"cy":2397,"by":2776},"byFundType":{"general":{"py":1864,"cy":2397,"by":2763},"special":{"py":0,"cy":0,"by":13}},"positions":{"py":372.6,"cy":417.6,"by":437.6},"description":"0290 - OFFICE OF TECHNOLOGY AND SOLUTIONS INTEGRATION\n\nThe Office of Technology and Solutions Integration's (OTSI) mission is to procure, manage, and deliver complex technology systems that support the delivery of health and human services for automation projects for the Health and Human Services Agency, the Department of Social Services, the Department of Health Care Services, the Department of Public Health, Emergency Medical Services Authority, and the Health Benefit Exchange, including:\n\n• California Healthcare Eligibility, Enrollment and Retention System (CalHEERS)\n\n• Case Management, Information and Payrolling System II (CMIPS)\n\n• Child Welfare Services/Case Management System (CWS/CMS)\n\n• Child Welfare Digital Services (CWDS)\n\n• Child Welfare Services - California Automated Response and Engagement System\n\n• Electronic Benefit Transfer System (EBT)\n\n• Electronic Visit and Verification (EVV)\n\n• Statewide Automated Welfare System (SAWS)\n\n• Welfare Data Tracking Implementation Project (WDTIP)\n\n• Center for Data Insights and Innovation (CDII)","extra":{"byAppropriationType":{"State Operations":{"py":658131,"cy":899658,"by":946658}},"apiProgramLine":true},"children":[{"id":"exp/4000/0530/0290/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":1864,"cy"