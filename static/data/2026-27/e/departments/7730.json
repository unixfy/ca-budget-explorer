8,"by":58}}}}]}],"excluded":{"nongovernmental":{"py":76,"cy":108,"by":108}}},{"id":"exp/7500/7730/6285","kind":"program","name":"Political Reform Audit","code":"6285","amounts":{"py":1791,"cy":2681,"by":0},"byFundType":{"general":{"py":1791,"cy":2681,"by":0}},"positions":{"py":12.9,"cy":13,"by":13},"description":"6285 - POLITICAL REFORM AUDIT\n\nThis program determines the accuracy and completeness of political statements and reports filed with the Secretary of State, and compliance with disclosures and record keeping requirements. On behalf of the Fair Political Practices Commission (FPPC), and in compliance with the Political Reform Act of 1974, the Franchise Tax Board conducts field audits of state and local candidates, measures committees, lobbying entities, committees supporting and opposing political candidates and statewide measures. These entities are randomly selected by the FPPC and/or meet dollar thresholds.","extra":{"byAppropriationType":{"State Operations":{"py":1791,"cy":2681,"by":0}},"apiProgramLine":true},"children":[{"id":"exp/7500/7730/6285/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":1791,"cy":2681,"by":0},"byFundType":{"general":{"py":1791,"cy":2681,"by":0}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":1791,"cy":2681,"by":0}}}}]},{"id":"exp/7500/7730/6290","kind":"program","name":"Department of Motor Vehicles Collections Program","code":"6290","amounts":{"py":10249,"cy":11382,"by":11375},"byFundType":{"special":{"py":10249,"cy":11382,"by":11375}},"positions":{"py":38.5,"cy":81.1,"by":81.1},"description":"6290 - DEPARTMENT OF MOTOR VEHICLES COLLECTIONS PROGRAM\n\n\r\nThis program's objective is to increase collections of delinquent motor vehicle license fees, taxes, and penalties on behalf of the Department of Motor Vehicles by utilizing the same collection capabilities that are used to collect the personal income tax.","extra":{"byAppropriationType":{"State Operations":{"py":10249,"cy":11382,"by":11375}},"apiProgramLine":true},"children":[{"id":"exp/7500/7730/6290/f0044","kind":"fund","name":"Motor Vehicle Account, State Transportation Fund","code":"0044","amounts":{"py":3551,"cy":3944,"by":3943},"byFundType":{"special":{"py":3551,"cy":3944,"by":3943}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":3551,"cy":3944,"by":3943}}}},{"id":"exp/7500/7730/6290/f0064","kind":"fund","name":"Motor Vehicle License Fee Account, Transportation Tax Fund","code":"0064","amounts":{"py":6698,"cy":7438,"by":7432},"byFundType":{"special":{"py":6698,"cy":7438,"by":7432}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":6698,"cy":7438,"by":7432}}}}]},{"id":"exp/7500/7730/6295","kind":"program","name":"Court Collection Program","code":"6295","amounts":{"py":8927,"cy":15532,"by":15528},"byFundType":{"special":{"py":8927,"cy":15532,"by":15528}},"positions":{"py":49.9,"cy":101.2,"by":101.2},"description":"6295 - COURT COLLECTION PROGRAM\n\n\r\nThis program's objective is to increase collections of delinquent fines, penalties, and orders imposed by, and on behalf of, superior, municipal, and justice courts by utilizing the same automated collection capabilities that are used to collect the personal income tax.","extra":{"byAppropriationType":{"State Operations":{"py":8927,"cy":15532,"by":15528}},"apiProgramLine":true},"children":[{"id":"exp/7500/7730/6295/f0242","kind":"fund","name":"Court Collection Account","code":"0242","amounts":{"py":8927,"cy":15532,"by":15528},"byFundType":{"special":{"py":8927,"cy":15532,"by":15528}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":8927,"cy":15532,"by":15528}}}}]},{"id":"exp/7500/7730/6300","kind":"program","name":"Legal Services Program","code":"6300","amounts":{"py":3062,"cy":3077,"by":3077},"byFundType":{"general":{"py":3062,"cy":3077,"by":3077}},"positions":{"py":0,"cy":0,"by":0},"description":"6300 - LEGAL SERVICES PROGRAM\n\nThis program reimburses the Department of Justice for legal services provided in support of Franchise Tax Board functions.","extra":{"byAppropriationType":{"State Operations":{"py":3062,"cy":3077,"by":3077}},"apiProgramLine":true},"children":[{"id":"exp/7500/7730/6300/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":3062,"cy":3077,"by":3077},"byFundType":{"general":{"py":3062,"cy":3077,"by":3077}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":3062,"cy":3077,"by":3077}}}}]},{"id":"exp/7500/7730/9900100","kind":"program","name":"Administration","code":"9900100","amounts":{"py":46063,"cy":47301,"by":47542},"byFundType":{"general":{"py":46063,"cy":47301,"by":47542}},"positions":{"py":340.8,"cy":320.6,"by":320.6},"description":"9900100 - ADMINISTRATION\n\nThis program provides executive leadership under the general direction of the Franchise Tax Board by directing departmental operations, developing and executing policies, making decisions concerning program operations, and ensuring that the Board's programs and services are carried out in accordance with Government Code sections 15701 and 15702. This program also provides the Board with the personnel, administration, training, budgeting, and accounting services necessary to ensure that these functions are performed with integrity, efficiency, and fairness.","extra":{"byAppropriationType":{"State Operations":{"py":46063,"cy":47301,"by":47542}},"apiProgramLine":true},"children":[{"id":"exp/7500/7730/9900100/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":46063,"cy":47301,"by":47542},"byFundType":{"general":{"py":46063,"cy":47301,"by":47542}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":46063,"cy":47301,"by":47542}}}}]},{"id":"exp/7500/7730/9900200","kind":"program","name":"Administration - Distributed","code":"9900200","amounts":{"py":-46063,"cy":-47301,"by":-47542},"byFundType":{"general":{"py":-46063,"cy":-47301,"by":-47542}},"positions":{"py":0,"cy":0,"by":0},"extra":{"byAppropriationType":{"State Operations":{"py":-46063,"cy":-47301,"by":-47542}},"apiProgramLine":true},"children":[{"id":"exp/7500/7730/9900200/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":-46063,"cy":-47301,"by":-47542},"byFundType":{"general":{"py":-46063,"cy":-47301,"by":-47542}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":-46063,"cy":-47301,"by":-47542}}}}]},{"id":"exp/7500/7730/6315","kind":"program","name":"Infrastructure (Capital Outlay)","code":"6315","amounts":{"py":5265,"cy":0,"by":0},"byFundType":{"general":{"py":5265,"cy":0,"by":0}},"description":"The Franchise Tax Board (FTB) Data Center facilities house critical IT infrastructure allowing the FTB to maintain day-to-day operations and generate revenue for the State of California. FTB currently maintains the Data Center that is currently housed in two locations in FTB's Sacramento Central Office Campus in Sacramento. The 'Los Angeles Building Data Center' was commissioned in 1985 and the 'Sacramento Building Data Center' was commissioned in 2005. The total space of the two locations encompasses approximately 26,000 square feet.","extra":{"infrastructure":true},"children":[{"id":"exp/7500/7730/6315/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":5265,"cy":0,"by":0},"byFundType":{"general":{"py":5265,"cy":0,"by":0}},"extra":{"fundType":"general","byAppropriationType":{"Capital Outlay":{"py":5265,"cy":0,"by":0}}}}]}],"sources":[{"label":"ebudget.ca.gov API: orgProgram/7730","url":"https://ebudget.ca.gov/api/budget/e/2026-27/orgProgram/7730"},{"label":"Detailed Expenditures by Program (PDF)","url":"https://ebudget.ca.gov/2026-27/pdf/Enacted/GovernorsBudget/7500/7730.pdf"}],"extra":{"legalCitations":"DEPARTMENT AUTHORITY\n\nGovernment Code section 15700-15705.\n\nPROGRAM AUTHORITY\n\n6280-Tax Programs:\nGovernment Code sections 15700-15705, 16370-16372; Revenue and Taxation 