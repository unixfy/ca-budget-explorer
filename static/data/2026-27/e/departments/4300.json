ra":{"fundType":"federal","byAppropriationType":{"Local Assistance":{"py":19528,"cy":19424,"by":20424}}}}]},{"id":"exp/4000/4300/4140031","kind":"subprogram","name":"Early Start Family Resources Services","code":"4140031","amounts":{"py":2003,"cy":2003,"by":2003},"byFundType":{"general":{"py":2003,"cy":2003,"by":2003}},"extra":{"byAppropriationType":{"Local Assistance":{"py":2003,"cy":2003,"by":2003}}},"children":[{"id":"exp/4000/4300/4140031/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":2003,"cy":2003,"by":2003},"byFundType":{"general":{"py":2003,"cy":2003,"by":2003}},"extra":{"fundType":"general","byAppropriationType":{"Local Assistance":{"py":2003,"cy":2003,"by":2003}}}}]}],"excluded":{"reimbursement":{"py":5607677,"cy":6672763,"by":7939851}}},{"id":"exp/4000/4300/4145","kind":"program","name":"State-Operated Residential and Community Facilities Program","code":"4145","amounts":{"py":259656,"cy":274363,"by":263784},"byFundType":{"general":{"py":259656,"cy":274363,"by":263784}},"positions":{"py":1352.9,"cy":1753.7,"by":1715.1},"description":"4145 - STATE-OPERATED RESIDENTIAL AND COMMUNITY FACILITIES PROGRAM\n\nThe Department is responsible for several locations and programs across California. Fairview Developmental Center in Orange County transitioned into cold shutdown in early 2026, in anticipation of long-term local government planning for the site, and no individuals have resided there since late 2022. Porterville Developmental Center in Tulare County provides secure treatment services for individuals who have been found incompetent to stand trial due to their intellectual or developmental disability or are dangerous to themselves or others and have been civilly committed to the facility by court order. Porterville Developmental Center is licensed as a General Acute Care Hospital and an Intermediate Care Facility. The Department also operates Stabilization, Training, Assistance, and Reintegration (STAR) residences in Northern, Central, and Southern California to provide acute crisis services in the community. The Department operates one community facility for persons who require specialized behavioral interventions, known as Canyon Springs in Riverside County, which is licensed as an Intermediate Care Facility. The Department also is developing three state-operated Complex Needs Homes, which will be located in Costa Mesa on a small portion of the site of the current Fairview Developmental Center.","extra":{"byAppropriationType":{"State Operations":{"py":291113,"cy":304605,"by":293282}},"apiProgramLine":true},"children":[{"id":"exp/4000/4300/4145010","kind":"subprogram","name":"AB 1202 Contracts","code":"4145010","amounts":{"py":0,"cy":125,"by":125},"byFundType":{"general":{"py":0,"cy":125,"by":125}},"extra":{"byAppropriationType":{"State Operations":{"py":0,"cy":125,"by":125}}},"children":[{"id":"exp/4000/4300/4145010/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":0,"cy":125,"by":125},"byFundType":{"general":{"py":0,"cy":125,"by":125}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":0,"cy":125,"by":125}}}}]},{"id":"exp/4000/4300/4145019","kind":"subprogram","name":"Medi-Cal Eligible Services","code":"4145019","amounts":{"py":180,"cy":180,"by":180},"byFundType":{"general":{"py":180,"cy":180,"by":180}},"extra":{"byAppropriationType":{"State Operations":{"py":180,"cy":180,"by":180}}},"children":[{"id":"exp/4000/4300/4145019/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":180,"cy":180,"by":180},"byFundType":{"general":{"py":180,"cy":180,"by":180}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":180,"cy":180,"by":180}}}}]},{"id":"exp/4000/4300/4145037","kind":"subprogram","name":"Rental Payments on Lease Revenue Bonds","code":"4145037","amounts":{"py":8263,"cy":8262,"by":8257},"byFundType":{"general":{"py":8263,"cy":8262,"by":8257}},"extra":{"byAppropriationType":{"State Operations":{"py":8