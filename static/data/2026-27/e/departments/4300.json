]}],"excludedChildren":[{"id":"exp/4000/4300/4145064","kind":"subprogram","name":"Training Programs to Establish Curriculum","code":"4145064","amounts":{"py":13,"cy":141,"by":141},"byFundType":{"nongovernmental":{"py":13,"cy":141,"by":141}},"extra":{"byAppropriationType":{"State Operations":{"py":13,"cy":141,"by":141}}},"children":[{"id":"exp/4000/4300/4145064/f0814","kind":"fund","name":"California State Lottery Education Fund","code":"0814","amounts":{"py":13,"cy":141,"by":141},"byFundType":{"nongovernmental":{"py":13,"cy":141,"by":141}},"extra":{"fundType":"nongovernmental","byAppropriationType":{"State Operations":{"py":13,"cy":141,"by":141}}}}]}],"excluded":{"reimbursement":{"py":31444,"cy":30101,"by":29357},"nongovernmental":{"py":13,"cy":141,"by":141}}},{"id":"exp/4000/4300/4149","kind":"program","name":"Program Administration","code":"4149","amounts":{"py":100431,"cy":116370,"by":127910},"byFundType":{"general":{"py":97016,"cy":111277,"by":122766},"special":{"py":633,"cy":977,"by":977},"federal":{"py":2782,"cy":4116,"by":4167}},"positions":{"py":835.6,"cy":810,"by":804},"description":"4149 - PROGRAM ADMINISTRATION\n\nThe objective of this program is to: (1) provide overall management, planning and policy development, as well as legal, legislative, audit, and administrative services; (2) manage revenue and reimbursement collections from federal and state programs, insurance companies, and private payers, and provide fiscal authority and oversight; (3) monitor regional center operations for compliance with statute, regulations, and their contracts with the Department; and (4) provide administrative and clinical management services to the state-operated programs to oversee the quality of services provided, maintain compliance with state licensing and federal certification requirements, protect individuals and staff, and care for facility structures and grounds.","extra":{"byAppropriationType":{"State Operations":{"py":154417,"cy":174169,"by":187991}},"apiProgramLine":true},"children":[{"id":"exp/4000/4300/4149001","kind":"subprogram","name":"Program Administration","code":"4149001","amounts":{"py":100431,"cy":116370,"by":127910},"byFundType":{"general":{"py":97016,"cy":111277,"by":122766},"special":{"py":633,"cy":977,"by":977},"federal":{"py":2782,"cy":4116,"by":4167}},"extra":{"byAppropriationType":{"State Operations":{"py":154417,"cy":174169,"by":187991}}},"children":[{"id":"exp/4000/4300/4149001/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":97016,"cy":111277,"by":122766},"byFundType":{"general":{"py":97016,"cy":111277,"by":122766}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":97016,"cy":111277,"by":122766}}}},{"id":"exp/4000/4300/4149001/f0172","kind":"fund","name":"Developmental Disabilities Program Development Fund","code":"0172","amounts":{"py":447,"cy":461,"by":461},"byFundType":{"special":{"py":447,"cy":461,"by":461}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":447,"cy":461,"by":461}}}},{"id":"exp/4000/4300/4149001/f0890","kind":"fund","name":"Federal Trust Fund","code":"0890","amounts":{"py":2782,"cy":4116,"by":4167},"byFundType":{"federal":{"py":2782,"cy":4116,"by":4167}},"extra":{"fundType":"federal","byAppropriationType":{"State Operations":{"py":2782,"cy":4116,"by":4167}}}},{"id":"exp/4000/4300/4149001/f3085","kind":"fund","name":"Behavioral Health Services Fund","code":"3085","amounts":{"py":186,"cy":516,"by":516},"byFundType":{"special":{"py":186,"cy":516,"by":516}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":186,"cy":516,"by":516}}}}],"excludedChildren":[{"id":"exp/4000/4300/4149001/f0995","kind":"fund","name":"Reimbursements","code":"0995","amounts":{"py":53986,"cy":57799,"by":60081},"byFundType":{"reimbursement":{"py":53986,"cy":57799,"by":60081}},"extra":{"fundType":"reimbursement","byAppropriationType":{"State Operations":{"py":53986,"cy":57799,"by":60081}}}}],"excluded":{"rei