 commencing with Section 95000.\n\n4145-State-Operated Residential and Community Facilities Program:\nWelfare and Institutions Code, Division 4.1, 4.5, 6, and 7.\n\n4149-Program Administration:\nWelfare and Institutions Code, Divisions 4.1, 4.5, 6, and 7; Government Code, Title 14; Health and Safety Code, Division 1, commencing with Section 416."},"excluded":{"reimbursement":{"py":5693107,"cy":6760663,"by":8029289},"nongovernmental":{"py":13,"cy":141,"by":141}}},"funding":{"id":"exp/4000/4300/funding","kind":"root","name":"Department of Developmental Services: Funding by fund and appropriation","amounts":{"py":9911975,"cy":11982864,"by":13545574},"byFundType":{"general":{"py":9834514,"cy":11920965,"by":13484183},"special":{"py":19102,"cy":2301,"by":1867},"federal":{"py":58359,"cy":59598,"by":59524}},"children":[{"id":"exp/4000/4300/funding/general","kind":"fundType","name":"General Fund","code":"general","amounts":{"py":9834514,"cy":11920965,"by":13484183},"byFundType":{"general":{"py":9834514,"cy":11920965,"by":13484183}},"children":[{"id":"exp/4000/4300/fund/0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":9834514,"cy":11920965,"by":13484183},"byFundType":{"general":{"py":9834514,"cy":11920965,"by":13484183}},"extra":{"fundType":"general","fundClass":"G","support":{"py":9834514,"cy":11920900,"by":13476249},"capitalOutlay":{"py":0,"cy":65,"by":7934}},"children":[{"id":"exp/4000/4300/fund/0001/4300-004-0001","kind":"item","name":"004 Budget Act appropriation (Developmental Centers)","amounts":{"py":180,"cy":305,"by":305},"extra":{"lineType":"item","appropriationType":"State Operations"},"code":"4300-004-0001"},{"id":"exp/4000/4300/fund/0001/4300-001-0001","kind":"item","name":"001 Budget Act appropriation","amounts":{"py":348049,"cy":377521,"by":377808},"extra":{"lineType":"item","appropriationType":"State Operations","enacted":{"py":348049,"cy":372759,"by":377808},"adjustments":[{"label":"Allocation for Employee Compensation","amounts":{"py":