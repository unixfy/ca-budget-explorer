{"orgCode":"0130","name":"Joint Expenses","agencyCode":"0010","agencyName":"Legislative, Judicial, and Executive","description":"The Legislature is comprised of two houses, the Senate and the Assembly, and is responsible for enacting laws and establishing public policy for California. Both houses contribute to support the Legislative Analyst's Office, which provides fiscal and policy advice to the Legislature, and is overseen by the 16-member bipartisan Joint Legislative Budget Committee.\n\nBecause the Legislature's programs drive a need for infrastructure investment, the Legislature has a capital outlay program to support this need. For the specifics on the Legislature's capital outlay program see \"Infrastructure Overview.\"","totals":{"amounts":{"py":300000,"cy":250000,"by":150000},"positions":{"py":0,"cy":0,"by":0}},"programs":{"id":"exp/0010/0130","kind":"department","name":"Joint Expenses","code":"0130","amounts":{"py":300000,"cy":250000,"by":150000},"positions":{"py":0,"cy":0,"by":0},"byFundType":{"special":{"py":300000,"cy":250000,"by":150000}},"children":[{"id":"exp/0010/0130/0980","kind":"program","name":"Support of the Office of the Legislative Analyst","code":"0980","amounts":{"py":12490,"cy":13334,"by":13964},"byFundType":{"general":{"py":12490,"cy":13334,"by":13964}},"positions":{"py":0,"cy":0,"by":0},"extra":{"byAppropriationType":{"State Operations":{"py":12490,"cy":13334,"by":13964}},"apiProgramLine":true},"children":[{"id":"exp/0010/0130/0980/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":12490,"cy":13334,"by":13964},"byFundType":{"general":{"py":12490,"cy":13334,"by":13964}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":12490,"cy":13334,"by":13964}}}}]},{"id":"exp/0010/0130/0985","kind":"program","name":"Transferred from Item 0110-001-0001","code":"0985","amounts":{"py":-6245,"cy":-6667,"by":-6982},"byFundType":{"general":{"py":-6245,"cy":-6667,"by":-6982}},"positions":{"py":0,"cy":0,"by":