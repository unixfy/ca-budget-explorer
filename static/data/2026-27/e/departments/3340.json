949,"by":0},"byFundType":{"bond":{"py":0,"cy":9949,"by":0}},"extra":{"fundType":"bond","byAppropriationType":{"Local Assistance":{"py":0,"cy":9949,"by":0}}}}]}]},{"id":"exp/3000/3340/2365","kind":"program","name":"Infrastructure (Capital Outlay)","code":"2365","amounts":{"py":0,"cy":6396,"by":0},"byFundType":{"other":{"py":0,"cy":6396,"by":0}},"description":"The California Conservation Corps (CCC) operates 26 facilities statewide, including 10 residential and 16 non-residential facilities in both urban and rural areas. These facilities enable the CCC to achieve its mission of providing employment, training, and educational opportunities to young individuals. The facilities also allow the CCC to assist federal, state, and local agencies as well as nonprofit entities with the conservation of California's natural resources.\n\nNon-residential centers range in size from about 15 to 95 Corpsmembers while the CCC residential facilities house 80 to 100 Corpsmembers each and operate 24 hours a day. Both types of centers bring young people together from across the state and increase the state's capacity for emergency response and conservation projects.","extra":{"infrastructure":true},"children":[{"id":"exp/3000/3340/2365/unreconciled","kind":"other","name":"Difference between project total and capital outlay by fund","amounts":{"py":0,"cy":6396,"by":0},"byFundType":{"other":{"py":0,"cy":6396,"by":0}},"extra":{"residual":true,"fundType":"other"}}],"excludedChildren":[{"id":"exp/3000/3340/2365/f0660","kind":"fund","name":"Public Buildings Construction Fund","code":"0660","amounts":{"py":428,"cy":0,"by":0},"byFundType":{"nongovernmental":{"py":428,"cy":0,"by":0}},"extra":{"fundType":"nongovernmental","byAppropriationType":{"Capital Outlay":{"py":428,"cy":0,"by":0}}}}],"excluded":{"nongovernmental":{"py":428,"cy":0,"by":0}}}],"sources":[{"label":"ebudget.ca.gov API: orgProgram/3340","url":"https://ebudget.ca.gov/api/budget/e/2026-27/orgProgram/3340"},{"label":"Detailed Expendit