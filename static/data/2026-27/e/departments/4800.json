{"orgCode":"4800","name":"California Health Benefit Exchange","agencyCode":"4000","agencyName":"Health and Human Services","description":"Covered California's mission is to increase the number of insured Californians, improve health care quality, lower costs, and reduce health disparities through an innovative, competitive marketplace that empowers consumers to choose the health plan and providers that give them the best value.\n\nCovered California is a public entity within state government with a five-member board appointed by the Governor and Legislature. Per Government Code section 100503(o), the board authorizes a budget to pay program expenses from the California Health Trust Fund to administer the Exchange.","totals":{"amounts":{"py":93663,"cy":227350,"by":364198},"positions":{"py":1363.7,"cy":1519,"by":1519},"excluded":{"nongovernmental":{"py":980280,"cy":1094519,"by":1062678}}},"programs":{"id":"exp/4000/4800","kind":"department","name":"California Health Benefit Exchange","code":"4800","amounts":{"py":93663,"cy":227350,"by":364198},"positions":{"py":1363.7,"cy":1519,"by":1519},"byFundType":{"general":{"py":14417,"cy":20350,"by":0},"special":{"py":79246,"cy":207000,"by":364198}},"children":[{"id":"exp/4000/4800/4202","kind":"program","name":"State Subsidy Program","code":"4202","amounts":{"py":93663,"cy":212350,"by":322350},"byFundType":{"general":{"py":14417,"cy":20350,"by":0},"special":{"py":79246,"cy":192000,"by":322350}},"positions":{"py":0,"cy":0,"by":0},"description":"4202 - STATE SUBSIDY PROGRAM\n\nThe State Subsidy Program provides state subsidies through the state-based health insurance exchange to eligible individuals and families and supports affordability for enrollees.","extra":{"byAppropriationType":{"Local Assistance":{"py":93663,"cy":212350,"by":322350}},"apiProgramLine":true},"children":[{"id":"exp/4000/4800/4202/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":14417,"cy":20350,"by":0},"byFundType":{"general":{"py":1