{"orgCode":"0516","name":"Secretary of California Housing and Homelessness Agency","agencyCode":"2000","agencyName":"Housing and Homelessness","description":"The California Housing and Homelessness Agency (Agency) works to enforce civil rights laws, including fair housing and equal employment protections. Its mission also encompasses efforts to prevent and end homelessness, supporting low-income renters and first-time homebuyers. The Agency aims to integrate state housing programs, streamline policies, and simplify the administration of the state's affordable housing initiatives.\n\nThe Agency is comprised of the following entities: the Civil Rights Department, the Department of Housing and Community Development, the California Housing Finance Agency, the Housing Development and Finance Committee, and the California Interagency Council on Homelessness.","totals":{"amounts":{"py":0,"cy":0,"by":4616},"positions":{"py":0,"cy":0,"by":18},"excluded":{"reimbursement":{"py":0,"cy":0,"by":1286}}},"programs":{"id":"exp/2000/0516","kind":"department","name":"Secretary of California Housing and Homelessness Agency","code":"0516","amounts":{"py":0,"cy":0,"by":4616},"positions":{"py":0,"cy":0,"by":18},"byFundType":{"general":{"py":0,"cy":0,"by":4616}},"children":[{"id":"exp/2000/0516/0266","kind":"program","name":"Administration of California Housing and Homelessness Agency","code":"0266","amounts":{"py":0,"cy":0,"by":4616},"byFundType":{"general":{"py":0,"cy":0,"by":4616}},"positions":{"py":0,"cy":0,"by":18},"extra":{"byAppropriationType":{"State Operations":{"py":0,"cy":0,"by":5902}},"apiProgramLine":true},"children":[{"id":"exp/2000/0516/0266/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":0,"cy":0,"by":4616},"byFundType":{"general":{"py":0,"cy":0,"by":4616}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":0,"cy":0,"by":4616}}}}],"excludedChildren":[{"id":"exp/2000/0516/0266/f0995","kind":"fund","name":"Reimbursements","c