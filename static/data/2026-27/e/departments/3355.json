{"orgCode":"3355","name":"Office of Energy Infrastructure Safety","agencyCode":"3000","agencyName":"Natural Resources","description":"The Office of Energy Infrastructure Safety's mission is to create a safer, sustainable California with utility infrastructure that is managed to reduce excavation and wildfire risk and is adaptable to an evolving climate.","totals":{"amounts":{"py":40132,"cy":48638,"by":45045},"positions":{"py":166.8,"cy":201,"by":223}},"programs":{"id":"exp/3000/3355","kind":"department","name":"Office of Energy Infrastructure Safety","code":"3355","amounts":{"py":40132,"cy":48638,"by":45045},"positions":{"py":166.8,"cy":201,"by":223},"byFundType":{"special":{"py":40132,"cy":48638,"by":45045}},"children":[{"id":"exp/3000/3355/2370","kind":"program","name":"Regulation of Energy Infrastructure Safety","code":"2370","amounts":{"py":40132,"cy":48638,"by":45045},"byFundType":{"special":{"py":40132,"cy":48638,"by":45045}},"positions":{"py":166.8,"cy":201,"by":223},"description":"2370 - REGULATION OF ENERGY INFRASTRUCTURE SAFETY\n\nEstablished pursuant to Chapter 81, Statutes of 2019 (AB 111), the Department:\n\n• Evaluates electrical corporation wildfire mitigation plans and annual updates, assesses electrical corporation compliance with approved plans, and makes enforcement recommendations to the California Public Utilities Commission.\n\n• Issues safety certifications to electrical corporations demonstrating proactive investments in wildfire safety, including agreeing to implement findings from safety culture assessments, having executive compensation structures tied to wildfire performance metrics, and reporting progress in implementing wildfire mitigation plans.\n\n• Supports the Wildfire Safety Advisory Board, which provides recommendations and advice to the Department on wildfire safety, mitigation performance metrics, and wildfire mitigation plan requirements in addition to reviewing and providing advisory opinions on publicly-owned electrical utility wildfire mitigation plans.\n\n• On behalf of the Underground Safety Board, coordinates the state's safe excavation outreach and education efforts, develops safe excavation standards, investigates accidents, and works with partner state agencies to enforce the \"Call Before You Dig\" law.\n\n• Evaluates large electrical corporations' 10-year distribution undergrounding plans and assesses large electrical corporation compliance with those plans.","extra":{"byAppropriationType":{"State Operations":{"py":40132,"cy":48638,"by":45045}},"apiProgramLine":true},"children":[{"id":"exp/3000/3355/2370/f0462","kind":"fund","name":"Public Utilities Commission Utilities Reimbursement Account","code":"0462","amounts":{"py":34472,"cy":40193,"by":36830},"byFundType":{"special":{"py":34472,"cy":40193,"by":36830}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":34472,"cy":40193,"by":36830}}}},{"id":"exp/3000/3355/2370/f3302","kind":"fund","name":"Safe Energy Infrastructure and Excavation Fund","code":"3302","amounts":{"py":5660,"cy":8445,"by":8215},"byFundType":{"special":{"py":5660,"cy":8445,"by":8215}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":5660,"cy":8445,"by":8215}}}}]}],"sources":[{"label":"ebudget.ca.gov API: orgProgram/3355","url":"https://ebudget.ca.gov/api/budget/e/2026-27/orgProgram/3355"},{"label":"Detailed Expenditures by Program (PDF)","url":"https://ebudget.ca.gov/2026-27/pdf/Enacted/GovernorsBudget/3000/3355.pdf"}],"extra":{"legalCitations":"DEPARTMENT AUTHORITY\n\nGovernment Code sections 4216-4216.24, 15470-15476; Public Utilities Code sections 326-326.2, 8385-8389."}},"funding":{"id":"exp/3000/3355/funding","kind":"root","name":"Office of Energy Infrastructure Safety: Funding by fund and appropriation","amounts":{"py":40132,"cy":48638,"by":45045},"byFundType":{"special":{"py":40132,"cy":48638,"by":45045}},"children":[{"id":"exp/3000/3355/funding/special","kind":"fundType","name":"Special Funds","co