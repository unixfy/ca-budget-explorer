{"orgCode":"0511","name":"Secretary for Government Operations Agency","agencyCode":"7500","agencyName":"Government Operations","description":"The Government Operations Agency is responsible for coordinating and overseeing state operations, including procurement, information technology, and human resources. The mission of the Government Operations Agency is to improve management and accountability of government programs, increase efficiency, and promote better and more coordinated operational decisions. The Government Operations Agency oversees the Office of Administrative Law, California Public Employees' Retirement System, California State Teachers' Retirement System, State Personnel Board, Victim Compensation Board, Department of FISCal, Department of General Services, Department of Technology, Office of Data and Innovation, Department of Human Resources, Franchise Tax Board, and Department of Tax and Fee Administration. In addition, the Government Operations Agency administers the Cradle-to-Career Data System, the Office of Civil Rights, the California Education Interagency Council, and the California Education Learning Lab.","totals":{"amounts":{"py":18847,"cy":24214,"by":40001},"positions":{"py":52,"cy":69,"by":70},"excluded":{"reimbursement":{"py":3717,"cy":3772,"by":3775}}},"programs":{"id":"exp/7500/0511","kind":"department","name":"Secretary for Government Operations Agency","code":"0511","amounts":{"py":18847,"cy":24214,"by":40001},"positions":{"py":52,"cy":69,"by":70},"byFundType":{"general":{"py":18847,"cy":24214,"by":40001}},"children":[{"id":"exp/7500/0511/0250","kind":"program","name":"Office of the Secretary of Government Operations","code":"0250","amounts":{"py":3350,"cy":5829,"by":14332},"byFundType":{"general":{"py":3350,"cy":5829,"by":14332}},"positions":{"py":28.4,"cy":28,"by":28},"extra":{"byAppropriationType":{"State Operations":{"py":7067,"cy":9601,"by":18107}},"apiProgramLine":true},"children":[{"id":"exp/7500/0511/0250/f0001","kind":"fund",