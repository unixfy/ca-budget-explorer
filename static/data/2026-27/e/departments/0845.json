 accounting matters relative to the premium tax program. Tax collections from this program are deposited in the state's General Fund.","extra":{"byAppropriationType":{"State Operations":{"py":1359,"cy":1643,"by":1641}},"apiProgramLine":true},"children":[{"id":"exp/0010/0845/0535/f0217","kind":"fund","name":"Insurance Fund","code":"0217","amounts":{"py":1359,"cy":1643,"by":1641},"byFundType":{"special":{"py":1359,"cy":1643,"by":1641}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":1359,"cy":1643,"by":1641}}}}]},{"id":"exp/0010/0845/9900100","kind":"program","name":"Administration","code":"9900100","amounts":{"py":43957,"cy":46949,"by":46548},"byFundType":{"special":{"py":43957,"cy":46949,"by":46548}},"positions":{"py":235.8,"cy":256,"by":256},"extra":{"byAppropriationType":{"State Operations":{"py":43957,"cy":46949,"by":46548}},"apiProgramLine":true},"children":[{"id":"exp/0010/0845/9900100/f0217","kind":"fund","name":"Insurance Fund","code":"0217","amounts":{"py":43957,"cy":46949,"by":46548},"byFundType":{"special":{"py":43957,"cy":46949,"by":46548}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":43957,"cy":46949,"by":46548}}}}]},{"id":"exp/0010/0845/9900200","kind":"program","name":"Administration - Distributed","code":"9900200","amounts":{"py":-43957,"cy":-46949,"by":-46548},"byFundType":{"special":{"py":-43957,"cy":-46949,"by":-46548}},"positions":{"py":0,"cy":0,"by":0},"extra":{"byAppropriationType":{"State Operations":{"py":-43957,"cy":-46949,"by":-46548}},"apiProgramLine":true},"children":[{"id":"exp/0010/0845/9900200/f0217","kind":"fund","name":"Insurance Fund","code":"0217","amounts":{"py":-43957,"cy":-46949,"by":-46548},"byFundType":{"special":{"py":-43957,"cy":-46949,"by":-46548}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":-43957,"cy":-46949,"by":-46548}}}}]}],"sources":[{"label":"ebudget.ca.gov API: orgProgram/0845","url":"https://ebudget.ca.gov/api/budget/e/2