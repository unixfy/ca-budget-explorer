{"orgCode":"3855","name":"Sierra Nevada Conservancy","agencyCode":"3000","agencyName":"Natural Resources","description":"The Sierra Nevada Conservancy's mission is to initiate, encourage, and support efforts that improve the environmental, economic, and social well-being of the Sierra Nevada region, its communities, and the people of California. The Conservancy achieves its mission by awarding grants and loans, developing projects and programs, providing strategic direction and resources to the Sierra Nevada region, and assisting in collaborative efforts with a broad array of governmental and non-governmental partners.","totals":{"amounts":{"py":17147,"cy":106694,"by":8605},"positions":{"py":43.3,"cy":46.3,"by":49.3},"excluded":{"reimbursement":{"py":14246,"cy":3375,"by":1649},"nongovernmental":{"py":643,"cy":1870,"by":0}}},"programs":{"id":"exp/3000/3855","kind":"department","name":"Sierra Nevada Conservancy","code":"3855","amounts":{"py":17147,"cy":106694,"by":8605},"positions":{"py":43.3,"cy":46.3,"by":49.3},"byFundType":{"general":{"py":8753,"cy":6181,"by":0},"special":{"py":5631,"cy":5747,"by":5976},"bond":{"py":2300,"cy":93291,"by":1354},"federal":{"py":463,"cy":1475,"by":1275}},"children":[{"id":"exp/3000/3855/3220","kind":"program","name":"Sierra Nevada Conservancy","code":"3220","amounts":{"py":17147,"cy":106694,"by":8605},"byFundType":{"general":{"py":8753,"cy":6181,"by":0},"special":{"py":5631,"cy":5747,"by":5976},"bond":{"py":2300,"cy":93291,"by":1354},"federal":{"py":463,"cy":1475,"by":1275}},"positions":{"py":43.3,"cy":46.3,"by":49.3},"description":"3220 - SIERRA NEVADA CONSERVANCY PROGRAM\n\nEstablished pursuant to Chapter 726, Statutes of 2004, the Conservancy is authorized to:\n\n• Provide increased opportunities for tourism and recreation.\n\n• Protect, conserve, and restore the region's physical, cultural, archaeological, historical, and living resources.\n\n• Aid in the preservation of working landscapes.\n\n• Reduce the risk of natural disasters, such as wildfires.\n\n• Protect and improve water and air quality.\n\n• Assist the regional economy through the operation of the Conservancy's program.\n\n• Undertake efforts to enhance public use and enjoyment of lands owned by the public.\n\nIn support of these programs, the Conservancy facilitates collaborative planning efforts with local and regional governments, community groups, and interested parties; provides technical assistance; and initiates and funds projects to identify and fill critical needs in the Sierra Nevada region.","extra":{"byAppropriationType":{"State Operations":{"py":7885,"cy":12871,"by":8429},"Local Assistance":{"py":23547,"cy":97198,"by":1825}},"apiProgramLine":true},"children":[{"id":"exp/3000/3855/3220/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":8753,"cy":6181,"by":0},"byFundType":{"general":{"py":8753,"cy":6181,"by":0}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":566,"cy":4635,"by":0},"Local Assistance":{"py":8187,"cy":1546,"by":0}}}},{"id":"exp/3000/3855/3220/f0140","kind":"fund","name":"California Environmental License Plate Fund","code":"0140","amounts":{"py":5631,"cy":5747,"by":5976},"byFundType":{"special":{"py":5631,"cy":5747,"by":5976}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":5631,"cy":5747,"by":5976}}}},{"id":"exp/3000/3855/3220/f0890","kind":"fund","name":"Federal Trust Fund","code":"0890","amounts":{"py":463,"cy":1475,"by":1275},"byFundType":{"federal":{"py":463,"cy":1475,"by":1275}},"extra":{"fundType":"federal","byAppropriationType":{"State Operations":{"py":463,"cy":1475,"by":1275}}}},{"id":"exp/3000/3855/3220/f6051","kind":"fund","name":"Safe Drinking Water, Water Quality and Supply, Flood Control, River and Coastal Protection Fund of 2006","code":"6051","amounts":{"py":0,"cy":39,"by":39},"byFundType":{"bond":{"py":0,"cy":39,"by":39}},"extra":{"fundType":"bond","byAppropriationType":{"State Operations":{"py":0,"cy":39,"by