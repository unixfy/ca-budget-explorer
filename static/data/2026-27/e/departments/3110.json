{"orgCode":"3110","name":"Special Resources Programs","agencyCode":"3000","agencyName":"Natural Resources","description":"The Special Resources Programs include the Tahoe Regional Planning Agency, the Yosemite Foundation Program, and the Sea Grant Program.","totals":{"amounts":{"py":5206,"cy":5753,"by":5653},"positions":{"py":0,"cy":0,"by":0},"excluded":{"nongovernmental":{"py":499,"cy":499,"by":499}}},"programs":{"id":"exp/3000/3110","kind":"department","name":"Special Resources Programs","code":"3110","amounts":{"py":5206,"cy":5753,"by":5653},"positions":{"py":0,"cy":0,"by":0},"byFundType":{"special":{"py":5206,"cy":5753,"by":5653}},"children":[{"id":"exp/3000/3110/2320","kind":"program","name":"Tahoe Regional Planning Agency","code":"2320","amounts":{"py":4483,"cy":4713,"by":4613},"byFundType":{"special":{"py":4483,"cy":4713,"by":4613}},"positions":{"py":0,"cy":0,"by":0},"description":"2320 - TAHOE REGIONAL PLANNING AGENCY\n\nA congressionally approved compact between California and Nevada established the Tahoe Regional Planning Agency (Agency). The Agency coordinates planning and regulations that preserve and enhance the environment and resources of the Lake Tahoe Basin. Funding for the Agency is shared between Nevada (one-third) and California (two-thirds).","extra":{"byAppropriationType":{"Local Assistance":{"py":4982,"cy":5212,"by":5112}},"apiProgramLine":true},"children":[{"id":"exp/3000/3110/2320/f0140","kind":"fund","name":"California Environmental License Plate Fund","code":"0140","amounts":{"py":4483,"cy":4713,"by":4613},"byFundType":{"special":{"py":4483,"cy":4713,"by":4613}},"extra":{"fundType":"special","byAppropriationType":{"Local Assistance":{"py":4483,"cy":4713,"by":4613}}}}],"excludedChildren":[{"id":"exp/3000/3110/2320/f0516","kind":"fund","name":"Harbors and Watercraft Revolving Fund","code":"0516","amounts":{"py":499,"cy":499,"by":499},"byFundType":{"nongovernmental":{"py":499,"cy":499,"by":499}},"extra":{"fundType":"nongovernmental","byApprop