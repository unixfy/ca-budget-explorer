{"orgCode":"3845","name":"San Diego River Conservancy","agencyCode":"3000","agencyName":"Natural Resources","description":"The San Diego River Conservancy is dedicated to the conservation, protection, and enhancement of the San Diego region's most valuable resources. Strategic programs prioritize land acquisition, recreation, the preservation of natural and cultural resources, and support water quality improvements and natural flood conveyance in the San Diego River watershed. The Conservancy leverages grant funding to ensure these efforts benefit the public. The Conservancy also collaborates with partner organizations to complete the San Diego River Trail that stretches 52 miles from the headwaters in Julian to the Pacific Ocean. Additionally, the Conservancy provides support for conservation projects in the neighboring watersheds of the Otay, Sweetwater, and Tijuana Rivers, enhances recreation opportunities, and strengthens forest and fire resilience throughout the San Diego region.","totals":{"amounts":{"py":2465,"cy":40097,"by":2329},"positions":{"py":3,"cy":4,"by":4},"excluded":{"reimbursement":{"py":1060,"cy":1060,"by":1060}}},"programs":{"id":"exp/3000/3845","kind":"department","name":"San Diego River Conservancy","code":"3845","amounts":{"py":2465,"cy":40097,"by":2329},"positions":{"py":3,"cy":4,"by":4},"byFundType":{"general":{"py":578,"cy":3740,"by":0},"special":{"py":401,"cy":441,"by":442},"bond":{"py":1486,"cy":35916,"by":1887}},"children":[{"id":"exp/3000/3845/3140","kind":"program","name":"San Diego River Conservancy","code":"3140","amounts":{"py":2465,"cy":40097,"by":2329},"byFundType":{"general":{"py":578,"cy":3740,"by":0},"special":{"py":401,"cy":441,"by":442},"bond":{"py":1486,"cy":35916,"by":1887}},"positions":{"py":3,"cy":4,"by":4},"extra":{"byAppropriationType":{"State Operations":{"py":696,"cy":1420,"by":1165},"Local Assistance":{"py":2829,"cy":39737,"by":2224}},"apiProgramLine":true},"children":[{"id":"exp/3000/3845/3140/f0001","kind":"fund","