{"orgCode":"7120","name":"California Workforce Development Board","agencyCode":"7000","agencyName":"Labor and Workforce Development","description":"The California Workforce Development Board is responsible for assisting in the development, oversight, and continuous improvement of California's workforce investment system and the alignment of the education and workforce investment systems with the needs of the 21st century economy and workforce. The Board provides leadership for a unified state plan that works in partnership with other state entities, including the Department of Social Services, the Department of Rehabilitation, the Community Colleges, and the Department of Education. The Board may also review statewide policies and programs and recommendations on actions that should be taken by the state to align workforce, education, training, and employment funding programs in a manner that supports a comprehensive, high-quality, and streamlined workforce development system, including the review and provision of comments on the State Plan, if any, for programs and activities of one-stop partners that are not core programs.","totals":{"amounts":{"py":123725,"cy":97089,"by":66398},"positions":{"py":96.1,"cy":100,"by":82.5},"excluded":{"reimbursement":{"py":0,"cy":11000,"by":16000}}},"programs":{"id":"exp/7000/7120","kind":"department","name":"California Workforce Development Board","code":"7120","amounts":{"py":123725,"cy":97089,"by":66398},"positions":{"py":96.1,"cy":100,"by":82.5},"byFundType":{"general":{"py":88630,"cy":83282,"by":55078},"special":{"py":15063,"cy":431,"by":261},"federal":{"py":20032,"cy":13376,"by":11059}},"children":[{"id":"exp/7000/7120/6040","kind":"program","name":"California Workforce Development Board","code":"6040","amounts":{"py":123725,"cy":97089,"by":66398},"byFundType":{"general":{"py":88630,"cy":83282,"by":55078},"special":{"py":15063,"cy":431,"by":261},"federal":{"py":20032,"cy":13376,"by":11059}},"positions":{"py":96.1,"cy":100,"by":82.5},"description":"6040 - CALIFORNIA WORKFORCE DEVELOPMENT BOARD\n\nThe California Workforce Development Board is the body responsible for assisting the Governor in the development, oversight, and continuous improvement of California's workforce investment system and the alignment of the education and workforce investment systems. The Board and its staff provide active ongoing policy analysis, technical assistance, and program evaluation to inform and shape the design of state workforce policies and their coordination with other relevant programs, including education and human service programs. The Board collaborates with both state and local partners, including business and industry, to develop the policies and framework necessary for meeting the demands of the 21st Century economy.","extra":{"byAppropriationType":{"State Operations":{"py":31128,"cy":29669,"by":33598},"Local Assistance":{"py":92597,"cy":78420,"by":48800}},"apiProgramLine":true},"children":[{"id":"exp/7000/7120/6040/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":88630,"cy":83282,"by":55078},"byFundType":{"general":{"py":88630,"cy":83282,"by":55078}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":10840,"cy":5032,"by":6278},"Local Assistance":{"py":77790,"cy":78250,"by":48800}}}},{"id":"exp/7000/7120/6040/f0890","kind":"fund","name":"Federal Trust Fund","code":"0890","amounts":{"py":20032,"cy":13376,"by":11059},"byFundType":{"federal":{"py":20032,"cy":13376,"by":11059}},"extra":{"fundType":"federal","byAppropriationType":{"State Operations":{"py":20032,"cy":13376,"by":11059}}}},{"id":"exp/7000/7120/6040/f3228","kind":"fund","name":"Greenhouse Gas Reduction Fund","code":"3228","amounts":{"py":14589,"cy":428,"by":261},"byFundType":{"special":{"py":14589,"cy":428,"by":261}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":256,"cy":261,"by":261},"Local Assistance":{"py":14333,"cy":167,"by":0}}}},{"id":"exp/7000/7120/60