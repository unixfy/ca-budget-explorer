{"orgCode":"9285","name":"Trial Court Security - Court Construction","agencyCode":"8000","agencyName":"General Government","description":"This budget establishes a process and mechanism for counties to request funding if court construction projects, occupied on or after October 9, 2011, modify or create building features that increase overall trial court security costs. Trial Court Security was realigned from the state to counties through 2011 Public Safety Realignment. Proposition 30, passed by the voters in 2012, requires the state to provide annual funding for newly required activities that have an overall effect of increasing county costs in this realigned program.","totals":{"amounts":{"py":9023,"cy":20000,"by":20000},"positions":{"py":0,"cy":0,"by":0}},"programs":{"id":"exp/8000/9285","kind":"department","name":"Trial Court Security - Court Construction","code":"9285","amounts":{"py":9023,"cy":20000,"by":20000},"positions":{"py":0,"cy":0,"by":0},"byFundType":{"general":{"py":9023,"cy":20000,"by":20000}},"children":[{"id":"exp/8000/9285/7580","kind":"program","name":"Trial Court Security","code":"7580","amounts":{"py":9023,"cy":20000,"by":20000},"byFundType":{"general":{"py":9023,"cy":20000,"by":20000}},"positions":{"py":0,"cy":0,"by":0},"extra":{"byAppropriationType":{"Local Assistance":{"py":9023,"cy":20000,"by":20000}},"apiProgramLine":true},"children":[{"id":"exp/8000/9285/7580/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":9023,"cy":20000,"by":20000},"byFundType":{"general":{"py":9023,"cy":20000,"by":20000}},"extra":{"fundType":"general","byAppropriationType":{"Local Assistance":{"py":9023,"cy":20000,"by":20000}}}}]}],"sources":[{"label":"ebudget.ca.gov API: orgProgram/9285","url":"https://ebudget.ca.gov/api/budget/e/2026-27/orgProgram/9285"},{"label":"Detailed Expenditures by Program (PDF)","url":"https://ebudget.ca.gov/2026-27/pdf/Enacted/GovernorsBudget/8000/9285.pdf"}]},"funding":{"id":"exp/8000/9285/funding","kind":"root","na