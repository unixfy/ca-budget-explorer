{"orgCode":"8825","name":"Commission on Asian and Pacific Islander American Affairs","agencyCode":"8000","agencyName":"General Government","description":"The California Commission on Asian and Pacific Islander American Affairs (CAPIAA) was established in 2002 and is charged with elevating the political, economic, and social issues of Asian and Pacific Islander Americans (APIA), in the state.\n\nCalifornia is proud to be home to seven million Asian and Pacific Islander Americans (APIA), the fastest growing ethnic population in the country.","totals":{"amounts":{"py":891,"cy":2162,"by":971},"positions":{"py":3.1,"cy":4,"by":4},"excluded":{"reimbursement":{"py":18,"cy":391,"by":0}}},"programs":{"id":"exp/8000/8825","kind":"department","name":"Commission on Asian and Pacific Islander American Affairs","code":"8825","amounts":{"py":891,"cy":2162,"by":971},"positions":{"py":3.1,"cy":4,"by":4},"byFundType":{"general":{"py":891,"cy":2162,"by":971}},"children":[{"id":"exp/8000/8825/6735","kind":"program","name":"Support","code":"6735","amounts":{"py":891,"cy":2162,"by":971},"byFundType":{"general":{"py":891,"cy":2162,"by":971}},"positions":{"py":3.1,"cy":4,"by":4},"description":"6735 - SUPPORT\n\nThe Commission advises the Governor and the Legislature on how to best respond to views, needs, and concerns of the state's diverse and complex APIA communities. Additionally, the commission provides assistance to policymakers, state agencies, departments, and other commissions to develop appropriate responses and programs that meet the needs of APIA communities, including focus on cultural language sensitivity, and hate incident and hate crime prevention measures.\n\nIn addition, in partnership with the State Department of Social Services, the Commission on Asian and Pacific Islander American Affairs, administers a grant program that provides support and services to victims and survivors of hate incidents and hate crimes and their families and facilitates hate incident or hate crime prevention measures.","extra":{"byAppropriationType":{"State Operations":{"py":909,"cy":2553,"by":971}},"apiProgramLine":true},"children":[{"id":"exp/8000/8825/6735/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":891,"cy":2162,"by":971},"byFundType":{"general":{"py":891,"cy":2162,"by":971}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":891,"cy":2162,"by":971}}}}],"excludedChildren":[{"id":"exp/8000/8825/6735/f0995","kind":"fund","name":"Reimbursements","code":"0995","amounts":{"py":18,"cy":391,"by":0},"byFundType":{"reimbursement":{"py":18,"cy":391,"by":0}},"extra":{"fundType":"reimbursement","byAppropriationType":{"State Operations":{"py":18,"cy":391,"by":0}}}}],"excluded":{"reimbursement":{"py":18,"cy":391,"by":0}}}],"sources":[{"label":"ebudget.ca.gov API: orgProgram/8825","url":"https://ebudget.ca.gov/api/budget/e/2026-27/orgProgram/8825"},{"label":"Detailed Expenditures by Program (PDF)","url":"https://ebudget.ca.gov/2026-27/pdf/Enacted/GovernorsBudget/8000/8825.pdf"}],"extra":{"legalCitations":"DEPARTMENT AUTHORITY\n\nGovernment Code, Title 2, Division 1, Chapter 3.3 (Sections 8255-8259.5)"},"excluded":{"reimbursement":{"py":18,"cy":391,"by":0}}},"funding":{"id":"exp/8000/8825/funding","kind":"root","name":"Commission on Asian and Pacific Islander American Affairs: Funding by fund and appropriation","amounts":{"py":891,"cy":2162,"by":971},"byFundType":{"general":{"py":891,"cy":2162,"by":971}},"children":[{"id":"exp/8000/8825/funding/general","kind":"fundType","name":"General Fund","code":"general","amounts":{"py":891,"cy":2162,"by":971},"byFundType":{"general":{"py":891,"cy":2162,"by":971}},"children":[{"id":"exp/8000/8825/fund/0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":891,"cy":2162,"by":971},"byFundType":{"general":{"py":891,"cy":2162,"by":971}},"extra":{"fundType":"general","fundClass":"G","support":{"py":891,"cy":2162,"by":971},"capitalOutlay":{"py":0,"cy":0,"by":0}},"c