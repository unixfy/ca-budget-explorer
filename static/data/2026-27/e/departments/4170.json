l":{"py":5346,"cy":4851,"by":8342},"federal":{"py":9524,"cy":11731,"by":11765}},"positions":{"py":15,"cy":9.7,"by":9.7},"description":"3905 - COMMUNITY-BASED PROGRAMS AND PROJECTS\n\nCommunity-based programs and projects includes the Health Insurance Counseling and Advocacy Program (HICAP). HICAP provides personalized counseling, community education, and outreach events for Medicare beneficiaries. HICAP is the primary local source for accurate and objective information and assistance with Medicare benefits, prescription drug plans, and health plans.\n\nAdditionally, the Aging and Disability Resource Connection (ADRC) program is a local, coordinated network of long-term services and supports (LTSS) providers which enable Californians to have the information and navigation support to make informed decisions and age with dignity. ADRC is an essential program in California's aging and disability No Wrong Door system and a key component of the Governor's Master Plan for Aging.","extra":{"byAppropriationType":{"State Operations":{"py":3435,"cy":3236,"by":3522},"Local Assistance":{"py":16314,"cy":18242,"by":21482}},"apiProgramLine":true},"children":[{"id":"exp/4000/4170/3905100","kind":"subprogram","name":"Health Insurance Counseling","code":"3905100","amounts":{"py":10733,"cy":12086,"by":15593},"byFundType":{"general":{"py":-12,"cy":6,"by":6},"special":{"py":5297,"cy":4851,"by":8342},"federal":{"py":5448,"cy":7229,"by":7245}},"extra":{"byAppropriationType":{"State Operations":{"py":2870,"cy":2574,"by":2842},"Local Assistance":{"py":12754,"cy":14402,"by":17642}}},"children":[{"id":"exp/4000/4170/3905100/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":-12,"cy":6,"by":6},"byFundType":{"general":{"py":-12,"cy":6,"by":6}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":-12,"cy":6,"by":6}}}},{"id":"exp/4000/4170/3905100/f0289","kind":"fund","name":"State HICAP Fund","code":"0289","amounts":{"py":5297,"cy":4851,"by":8342},"b