itions":{"py":68.7,"cy":84.1,"by":84.1},"description":"6780 - STATE AUDITS AND EVALUATIONS\n\nThe Department of Finance systematically reviews and evaluates state-administered and financed programs. The Office of State Audits and Evaluations assists the Director of Finance in fulfilling the statutory responsibilities for supervision over all matters concerning the financial and business policies of the state by conducting financial audits and by performing critical examinations of state programs and policies including the oversight activities associated with the dissolution of redevelopment agencies.","extra":{"byAppropriationType":{"State Operations":{"py":18650,"cy":22276,"by":23308}},"apiProgramLine":true},"children":[{"id":"exp/8000/8860/6780/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":8842,"cy":9399,"by":9188},"byFundType":{"general":{"py":8842,"cy":9399,"by":9188}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":8842,"cy":9399,"by":9188}}}},{"id":"exp/8000/8860/6780/f3314","kind":"fund","name":"California Cannabis Tax Fund","code":"3314","amounts":{"py":17,"cy":0,"by":0},"byFundType":{"special":{"py":17,"cy":0,"by":0}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":17,"cy":0,"by":0}}}},{"id":"exp/8000/8860/6780/f3342","kind":"fund","name":"Cannabis Tax Fund - Department of Finance","code":"3342","amounts":{"py":440,"cy":0,"by":770},"byFundType":{"special":{"py":440,"cy":0,"by":770}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":440,"cy":0,"by":770}}}}],"excludedChildren":[{"id":"exp/8000/8860/6780/f0995","kind":"fund","name":"Reimbursements","code":"0995","amounts":{"py":5785,"cy":8069,"by":8516},"byFundType":{"reimbursement":{"py":5785,"cy":8069,"by":8516}},"extra":{"fundType":"reimbursement","byAppropriationType":{"State Operations":{"py":5785,"cy":8069,"by":8516}}}},{"id":"exp/8000/8860/6780/f9740","kind":"fund","name":"Central Service Cost Recovery Fund","code":"9740","amounts":{"py":3566,"cy":4808,"by":4834},"byFundType":{"nongovernmental":{"py":3566,"cy":4808,"by":4834}},"extra":{"fundType":"nongovernmental","byAppropriationType":{"State Operations":{"py":3566,"cy":4808,"by":4834}}}}],"excluded":{"reimbursement":{"py":5785,"cy":8069,"by":8516},"nongovernmental":{"py":3566,"cy":4808,"by":4834}}},{"id":"exp/8000/8860/6785","kind":"program","name":"Statewide Accounting Policies, Consulting and Training","code":"6785","amounts":{"py":7226,"cy":8441,"by":8487},"byFundType":{"general":{"py":7226,"cy":8441,"by":8487}},"positions":{"py":41.3,"cy":51.8,"by":51.8},"description":"6785 - STATEWIDE ACCOUNTING POLICIES, CONSULTING AND TRAINING\n\nThe Department of Finance is responsible for devising and maintaining a modern and uniform system of statewide accounting. The Fiscal Systems and Consulting Unit sets statewide fiscal and accounting policies and procedures. The unit provides fiscal and accounting training, advice, and consulting services to departments to ensure that the state's assets are protected, and that accurate and timely financial information is maintained. The Department of Finance participates in the development of statewide financial systems.","extra":{"byAppropriationType":{"State Operations":{"py":11539,"cy":13961,"by":14031}},"apiProgramLine":true},"children":[{"id":"exp/8000/8860/6785055","kind":"subprogram","name":"Fiscal Systems and Consulting","code":"6785055","amounts":{"py":7226,"cy":8441,"by":8487},"byFundType":{"general":{"py":7226,"cy":8441,"by":8487}},"extra":{"byAppropriationType":{"State Operations":{"py":11539,"cy":13961,"by":14031}}},"children":[{"id":"exp/8000/8860/6785055/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":7226,"cy":8441,"by":8487},"byFundType":{"general":{"py":7226,"cy":8441,"by":8487}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":7226,"cy":8441,"by":8487}}}}],"excludedChildren":[{"id":"exp/8000/8860