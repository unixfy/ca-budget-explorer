{"orgCode":"9670","name":"Equity Claims and Settlements and Judgments","agencyCode":"8000","agencyName":"General Government","description":"This budget reflects statewide expenditures for all equity claims against the state approved for payment by the California Victim Compensation Board and the Government Claims Program under the Department of General Services, and all settlements and judgments against the state sponsored by the Attorney General's Office. Payment of these claims is provided to claimants through the passage of special legislation.","totals":{"amounts":{"py":19839,"cy":1222,"by":0},"positions":{"py":0,"cy":0,"by":0}},"programs":{"id":"exp/8000/9670","kind":"department","name":"Equity Claims and Settlements and Judgments","code":"9670","amounts":{"py":19839,"cy":1222,"by":0},"positions":{"py":0,"cy":0,"by":0},"byFundType":{"general":{"py":19812,"cy":1222,"by":0},"special":{"py":27,"cy":0,"by":0}},"children":[{"id":"exp/8000/9670/7765","kind":"program","name":"Equity Claims","code":"7765","amounts":{"py":19839,"cy":1222,"by":0},"byFundType":{"general":{"py":19812,"cy":1222,"by":0},"special":{"py":27,"cy":0,"by":0}},"positions":{"py":0,"cy":0,"by":0},"description":"7765 - EQUITY CLAIMS\n\nThis program includes all claims approved by the three-member California Victim Compensation Board and the Government Claims Program under the Department of General Services, and referred to the Legislature in the omnibus claims bills for payment. The program provides an equitable procedure for the payment of the following categories of claims:\n\n• Claims for which no appropriation has been made or for which no fund is available, but the settlement of which has been provided for by statute or constitutional provision.\n\n• Claims for which the appropriation made or fund designated is exhausted.\n\n• Claims for which settlement is not otherwise provided for by statute or constitutional provision.\n\nThe Government Claims Program was transferred to the Department of General Services from the former California Victim Compensation and Government Claims Board in July 2016. The California Victim Compensation and Government Claims Board became the California Victim Compensation Board.","extra":{"byAppropriationType":{"State Operations":{"py":19839,"cy":1222,"by":0}},"apiProgramLine":true},"children":[{"id":"exp/8000/9670/7765/f0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":19812,"cy":1222,"by":0},"byFundType":{"general":{"py":19812,"cy":1222,"by":0}},"extra":{"fundType":"general","byAppropriationType":{"State Operations":{"py":19812,"cy":1222,"by":0}}}},{"id":"exp/8000/9670/7765/f0044","kind":"fund","name":"Motor Vehicle Account, State Transportation Fund","code":"0044","amounts":{"py":27,"cy":0,"by":0},"byFundType":{"special":{"py":27,"cy":0,"by":0}},"extra":{"fundType":"special","byAppropriationType":{"State Operations":{"py":27,"cy":0,"by":0}}}}]}],"sources":[{"label":"ebudget.ca.gov API: orgProgram/9670","url":"https://ebudget.ca.gov/api/budget/e/2026-27/orgProgram/9670"},{"label":"Detailed Expenditures by Program (PDF)","url":"https://ebudget.ca.gov/2026-27/pdf/Enacted/GovernorsBudget/8000/9670.pdf"}],"extra":{"legalCitations":"DEPARTMENT AUTHORITY\n\nGovernment Code Section 905.2."}},"funding":{"id":"exp/8000/9670/funding","kind":"root","name":"Equity Claims and Settlements and Judgments: Funding by fund and appropriation","amounts":{"py":19839,"cy":1222,"by":0},"byFundType":{"general":{"py":19812,"cy":1222,"by":0},"special":{"py":27,"cy":0,"by":0}},"children":[{"id":"exp/8000/9670/funding/general","kind":"fundType","name":"General Fund","code":"general","amounts":{"py":19812,"cy":1222,"by":0},"byFundType":{"general":{"py":19812,"cy":1222,"by":0}},"children":[{"id":"exp/8000/9670/fund/0001","kind":"fund","name":"General Fund","code":"0001","amounts":{"py":19812,"cy":1222,"by":0},"byFundType":{"general":{"py":19812,"cy":1222,"by":0}},"extra":{"fundType":"general","fundClass":"G","support":{"py":19812,"cy":